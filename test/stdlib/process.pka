use proc;

export fn main() void = {
	// GetPid
	let pid = proc::GetPid();
	assert(pid > 0);

	// MilliSleep
	proc::MilliSleep(5);

	// Create and Wait
	let argv: [1]str = ["/bin/true"];
	let child = proc::MustCreate("/bin/true", argv[0z..1z]);
	assert(child > 0);
	let status = proc::Wait(child, -1);
	assert(status == 0);

	// Priority
	let min_p = proc::MinPriority();
	let max_p = proc::MaxPriority();
	assert(min_p <= max_p);
	let cur_p = proc::GetPriority(0);
	assert(cur_p >= min_p);
	assert(cur_p <= max_p);
};
