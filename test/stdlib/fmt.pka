use fmt;
use strings;

export fn main() void = {
	let storage: [256]u8 = [0...];
	let b: fmt::Buffer = fmt::New(storage[0z..256z]);

	// Write and ToStr
	fmt::Write(&b, "hello");
	assert(fmt::ToStr(&b) == "hello");

	// Append more
	fmt::Write(&b, " world");
	assert(fmt::ToStr(&b) == "hello world");

	// Clear
	fmt::Clear(&b);
	assert(fmt::ToStr(&b) == "");

	// Wbool
	fmt::Wbool(&b, true);
	assert(fmt::ToStr(&b) == "true");
	fmt::Clear(&b);
	fmt::Wbool(&b, false);
	assert(fmt::ToStr(&b) == "false");

	// Wi64 decimal (default mode/pad)
	fmt::Clear(&b);
	fmt::Wi64(&b, 42);
	assert(fmt::ToStr(&b) == "42");

	// Wi64 negative
	fmt::Clear(&b);
	fmt::Wi64(&b, -123);
	assert(fmt::ToStr(&b) == "-123");

	// Wi64 zero
	fmt::Clear(&b);
	fmt::Wi64(&b, 0);
	assert(fmt::ToStr(&b) == "0");

	// Wi64 hex
	fmt::Clear(&b);
	fmt::Wi64(&b, 255, "hex");
	assert(fmt::ToStr(&b) == "ff");

	// Wi64 with padding
	fmt::Clear(&b);
	fmt::Wi64(&b, 42, "dec", 5);
	assert(fmt::ToStr(&b) == "00042");

	// Wu64 (default mode/pad)
	fmt::Clear(&b);
	fmt::Wu64(&b, 12345u64);
	assert(fmt::ToStr(&b) == "12345");

	// Wu64 hex
	fmt::Clear(&b);
	fmt::Wu64(&b, 255u64, "hex");
	assert(fmt::ToStr(&b) == "ff");

	// Wf64 eng mode (default dec=10, mode="eng")
	fmt::Clear(&b);
	fmt::Wf64(&b, 3.5f64);
	assert(fmt::ToStr(&b) == "3.5");

	// Wf64 zero with explicit dec
	fmt::Clear(&b);
	fmt::Wf64(&b, 0.0f64, 2, "dec");
	assert(fmt::ToStr(&b) == "0.00");

	// Wf64 negative (default args)
	fmt::Clear(&b);
	fmt::Wf64(&b, -1.5f64);
	assert(fmt::ToStr(&b) == "-1.5");

	// F format (default unused args)
	fmt::Clear(&b);
	fmt::F(&b, "hello %s!", "world");
	assert(fmt::ToStr(&b) == "hello world!");

	// F multiple args
	fmt::Clear(&b);
	fmt::F(&b, "%s + %s = %s", "1", "2", "3");
	assert(fmt::ToStr(&b) == "1 + 2 = 3");

	// F literal percent
	fmt::Clear(&b);
	fmt::F(&b, "100%%");
	assert(fmt::ToStr(&b) == "100%");

	// Prints (just ensure it doesn't crash)
	fmt::Prints("stdlib/fmt: ");
	fmt::Printsln("OK");
};
