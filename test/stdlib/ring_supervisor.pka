use proc;
use strings;
use rt;

fn ensure_proc(pid: i32, path: proc_cstr, prio: i32) i32 = {
	let cur = pid;
	if (cur <= 0) {
		cur = proc::spawn_simple(path);
		if (cur > 0) { proc::setpriority_process(cur, prio); };
		return cur;
	};
	let status: i32 = 0;
	let waited = proc::wait_nohang(cur, &status);
	if (waited == cur) {
		cur = proc::spawn_simple(path);
		if (cur > 0) { proc::setpriority_process(cur, prio); };
	};
	return cur;
};

export fn main() void = {
	if (proc::pdeathsig(proc::SIGKILL) != 0) { return; };
	if (proc::getppid() == 1) { return; };
	let writer_path = strings::toutf8("./ring_writer\0"): *[*]u8: proc_cstr;
	let server_path = strings::toutf8("./ring_server\0"): *[*]u8: proc_cstr;
	let client_path = strings::toutf8("./ring_client\0"): *[*]u8: proc_cstr;

	let writer = proc::spawn_simple(writer_path: proc::cstr);
	if (writer > 0) { proc::setpriority_process(writer, 10); };
	proc::sleep_ms(100);
	let server = proc::spawn_simple(server_path: proc::cstr);
	if (server > 0) { proc::setpriority_process(server, 5); };
	proc::sleep_ms(100);
	let client = proc::spawn_simple(client_path: proc::cstr);
	if (client > 0) { proc::setpriority_process(client, 0); };

	for (true) {
		writer = ensure_proc(writer, writer_path: proc::cstr, 10);
		server = ensure_proc(server, server_path: proc::cstr, 5);
		client = ensure_proc(client, client_path: proc::cstr, 0);
		proc::sleep_ms(2000);
	};
};
