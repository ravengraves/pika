use file;
use strings;

export fn main() void = {
	let path = "/tmp/libpk_file_test.txt";
	let data_str = "pkio test\n";
	let data = strings::toutf8(data_str);

	// Open / Write / Close
	let fd = file::MustOpen(path, "w");
	let wrote = file::MustWrite(fd, data);
	assert(wrote == data.len: i64);
	file::Close(fd);

	// Exists / IsFile / IsDir
	assert(file::Exists(path) == true);
	assert(file::IsFile(path) == true);
	assert(file::IsDir(path) == false);
	assert(file::IsDir("/tmp") == true);

	// Size
	assert(file::Size(path) == data.len: i64);

	// Read back
	let fd2 = file::MustOpen(path, "r");
	let buf: [64]u8 = [0...];
	let nread = file::MustRead(fd2, buf[0z..data.len]);
	assert(nread == data.len: i64);

	// Verify contents
	let i: size = 0z;
	for (i < data.len) {
		assert(buf[i] == data[i]);
		i = i + 1z;
	};
	file::Close(fd2);

	// Seek / Loc
	let fd3 = file::MustOpen(path, "r");
	let seeked = file::MustSeek(fd3, 5);
	assert(seeked == 5);
	assert(file::Loc(fd3) == 5);
	file::Close(fd3);

	// Del
	file::MustDel(path);
	assert(file::Exists(path) == false);

	// Mkdir / Rmdir
	let dir = "/tmp/libpk_test_dir";
	file::Rmdir(dir);
	file::MustMkdir(dir);
	assert(file::IsDir(dir) == true);
	file::MustRmdir(dir);
	assert(file::Exists(dir) == false);

	// OpenDir / DirNext / CloseDir
	let dh = file::MustOpenDir("/tmp");
	let count: i32 = 0;
	let nbuf: [256]u8 = [0...];
	for (true) {
		let entry = file::DirNext(dh, nbuf[0z..256z]);
		if (file::IsDirDone(entry)) {
			break;
		};
		count = count + 1;
	};
	file::CloseDir(dh);
	assert(count > 0);

	// Rename
	let path_a = "/tmp/libpk_rename_a.txt";
	let path_b = "/tmp/libpk_rename_b.txt";
	let fda = file::MustOpen(path_a, "w");
	file::Close(fda);
	file::MustRename(path_a, path_b);
	assert(file::Exists(path_a) == false);
	assert(file::Exists(path_b) == true);
	file::Del(path_b);
};
