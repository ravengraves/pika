use crypt;

export fn main() void = {
	let buf: [32]u8 = [0...];
	crypt::MustRandom(buf[0z..32z]);

	// Verify not all zeros (extremely unlikely for 32 random bytes)
	let nonzero: i32 = 0;
	let i: size = 0z;
	for (i < 32z) {
		if (buf[i] != 0) {
			nonzero = nonzero + 1;
		};
		i = i + 1z;
	};
	assert(nonzero > 0);
};
