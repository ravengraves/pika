use env;

export fn main() void = {
	assert(env::Has("PIKA_ENV_TEST"));
	assert(env::Get("PIKA_ENV_TEST") == "rose");

	assert(env::Has("PIKA_ENV_EMPTY"));
	assert(env::Get("PIKA_ENV_EMPTY", "fallback") == "");

	assert(!env::Has("PIKA_ENV_MISSING"));
	assert(env::Get("PIKA_ENV_MISSING", "fallback") == "fallback");
};
