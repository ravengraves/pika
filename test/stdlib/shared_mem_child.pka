use file;
use proc;
use rt;
use shm;
use strings;

export fn main() void = {
	let path = strings::toutf8("/tmp/libpk_shm.bin\0"): *[*]u8;
	let length: size = 64;
	let fd: i32 = -1;
	let map = shm::map_shared_existing(path: shm::cstr, length, &fd);
	assert(map != shm::map_failed());

	let buf: *[*]u8 = map: *[*]u8;
	buf[1] = 'B';
	shm::sync(map, length, shm::MS_SYNC);
	assert(shm::unmap(map, length) == 0);
	assert(file::close(fd) == 0);
	proc::exit(0);
};
