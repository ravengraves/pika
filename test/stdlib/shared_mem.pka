use file;
use proc;
use rt;
use shm;
use strings;

export fn main() void = {
	let path = strings::toutf8("/tmp/libpk_shm.bin\0"): *[*]u8;
	let length: size = 64;
	let fd: i32 = -1;
	let map = shm::map_shared_file(path: shm::cstr, length, 0o600, &fd);
	assert(map != shm::map_failed());

	let buf: *[*]u8 = map: *[*]u8;
	buf[0] = 'A';

	let child_path = strings::toutf8("./build/bin/shared_mem_child\0"): *[*]u8;
	let pid = proc::spawn_simple(child_path: proc::cstr);
	assert(pid > 0);

	let status: i32 = 0;
	let waited = proc::wait(pid, &status);
	assert(waited == pid);
	assert(status == 0);

	assert(buf[0] == 'A');
	assert(buf[1] == 'B');

	assert(shm::unmap(map, length) == 0);
	assert(file::close(fd) == 0);
};
