use net;
use proc;
use rt;

export fn main() void = {
	let port = ring_read_port_file();
	let fd = net::tcp_connect_local(port);
	for (fd < 0) {
		proc::sleep_ms(50);
		fd = net::tcp_connect_local(port);
	};

	let buf: [64]u8 = [0...];
	for (true) {
		let got = net::recv(fd, &buf: *opaque, 64, 0);
		if (got <= 0) {
			net::close(fd);
			proc::sleep_ms(50);
			fd = net::tcp_connect_local(port);
			continue;
		};
		rt::write(1, &buf: *opaque, got: size);
	};
};
