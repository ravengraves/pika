use sys;
use rt;

export fn main() void = {
	// Test getuid/geteuid
	let uid = sys::getuid();
	let euid = sys::geteuid();
	assert(uid >= 0);
	assert(euid >= 0);

	// Test getgid/getegid
	let gid = sys::getgid();
	let egid = sys::getegid();
	assert(gid >= 0);
	assert(egid >= 0);

	// Test getpid/getppid
	let pid = sys::getpid();
	let ppid = sys::getppid();
	assert(pid > 0);
	assert(ppid > 0);

	// Test isroot helper
	let root = sys::isroot();
	// Just make sure it doesn't crash - result depends on who runs it

	// Test getrandom
	let buf: [16]u8 = [0...];
	let ok = sys::random_bytes(&buf: *[*]u8, 16);
	assert(ok == true);

	// Verify we got some random data (extremely unlikely to be all zeros)
	let nonzero: i32 = 0;
	for (let i = 0z; i < 16; i += 1) {
		if (buf[i] != 0) { nonzero += 1; };
	};
	assert(nonzero > 0);
};
