use file;
use io;
use net;
use proc;
use rt;
use strings;

fn write_port(path: file::cstr, port: u16) void = {
	let fd = file::open_rw_trunc(path, 0o600);
	assert(fd >= 0);
	let data: [2]u8 = [0...];
	data[0] = port: u8;
	data[1] = (port >> 8): u8;
	let wrote = file::write_all(fd, &data: *opaque, 2);
	assert(wrote == 2);
	assert(file::close(fd) == 0);
};

export fn main() void = {
	// Test io::poll with TCP sockets
	let port: u16 = 0;
	let server = net::tcp_listen_local(0, 8, &port);
	assert(server >= 0);

	let port_path = strings::toutf8("/tmp/libpk_io.port\0"): *[*]u8;
	write_port(port_path: file::cstr, port);
	let child_path = strings::toutf8("./build/bin/io_client\0"): *[*]u8;
	let pid = proc::spawn_simple(child_path: proc::cstr);
	assert(pid > 0);

	// Parent: poll for incoming connection
	let pfd = io_pollfd { fd = server, events = io::POLLIN, revents = 0 };
	let ret = io::poll(&pfd, 1, 2000);
	assert(ret == 1);
	assert((pfd.revents & io::POLLIN) != 0);

	// Accept connection
	let peer: net_sockaddr_in = net_sockaddr_in {
		family = 0, port = 0, addr = 0, zero = 0,
	};
	let peer_len: net_socklen = size(net_sockaddr_in): net_socklen;
	let conn = net::accept(server, &peer: *opaque, &peer_len);
	assert(conn >= 0);

	// Poll for data on connection
	let readable = io::wait_readable(conn, 2000);
	assert(readable == true);

	// Read data
	let buf: [4]u8 = [0...];
	let recvd = net::recv(conn, &buf: *opaque, 4, 0);
	assert(recvd == 4);
	assert(buf[0] == 't');
	assert(buf[1] == 'e');
	assert(buf[2] == 's');
	assert(buf[3] == 't');

	net::close(conn);
	net::close(server);

	// Wait for child
	let status: i32 = 0;
	let waited = proc::wait(pid, &status);
	assert(waited == pid);
	assert(status == 0);

	// Test poll timeout (no events)
	let server2 = net::tcp_listen_local(0, 8, &port);
	assert(server2 >= 0);
	let pfd2 = io_pollfd { fd = server2, events = io::POLLIN, revents = 0 };
	let ret2 = io::poll(&pfd2, 1, 10);  // 10ms timeout
	assert(ret2 == 0);  // timeout, no events
	net::close(server2);

	file::rm(port_path: file::cstr);
};
