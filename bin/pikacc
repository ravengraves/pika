#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BOOTSTRAP_BIN="$ROOT_DIR/build/pikacc"
BOOTSTRAP_SRC="$ROOT_DIR/bin/pikacc.pka"
LEGACY_DRIVER="$ROOT_DIR/bin/pikacc.sh"

needs_rebuild=0
if [ ! -x "$BOOTSTRAP_BIN" ]; then
	needs_rebuild=1
elif [ "$BOOTSTRAP_SRC" -nt "$BOOTSTRAP_BIN" ]; then
	needs_rebuild=1
elif [ "$LEGACY_DRIVER" -nt "$BOOTSTRAP_BIN" ]; then
	needs_rebuild=1
fi

if [ "$needs_rebuild" -eq 1 ]; then
	mkdir -p "$ROOT_DIR/build"
	"$LEGACY_DRIVER" "$BOOTSTRAP_SRC" --platform libc -O1 -o "$BOOTSTRAP_BIN"
fi

if [ -n "${CFLAGS_EXTRA:-}" ] || [ -n "${LIBS:-}" ]; then
	exec "$LEGACY_DRIVER" "$@"
fi

exec "$BOOTSTRAP_BIN" "$@"
