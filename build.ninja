# Pika build — Linux/macOS

rule sh
  command = sh $in
  pool = console

# Bootstrap
build bootstrap_pikacc: sh scripts/bootstrap_pikacc.sh

# Tests
build run_tests: sh scripts/test.sh || bootstrap_pikacc
build run_stdlib_tests: sh scripts/test_stdlib.sh || bootstrap_pikacc
build run_math_tests: sh scripts/test_math.sh || bootstrap_pikacc

# Benchmarks
build run_benchmarks: sh scripts/benchmark.sh
build run_benchmarks_c: sh scripts/benchmark_c.sh
build run_benchmarks_rs: sh scripts/benchmark_rs.sh

# Aggregate targets
build check: phony bootstrap_pikacc run_tests run_stdlib_tests run_math_tests
build bench: phony run_benchmarks
build bench_c: phony run_benchmarks_c
build bench_rs: phony run_benchmarks_rs
build bench_all: phony run_benchmarks run_benchmarks_c run_benchmarks_rs

# Clean
rule clean_cmd
  command = rm -rf build/

build clean: clean_cmd

# Default
default bootstrap_pikacc check
