type file_cstr = *[*]u8;

def file_O_RDONLY: i32 = 0;
def file_O_WRONLY: i32 = 1;
def file_O_RDWR: i32 = 2;
def file_O_CREAT: i32 = 0x40;
def file_O_TRUNC: i32 = 0x200;
def file_O_APPEND: i32 = 0x400;
def file_O_DIRECTORY: i32 = 0x10000;

def file_DT_UNKNOWN: u8 = 0;
def file_DT_FIFO: u8 = 1;
def file_DT_CHR: u8 = 2;
def file_DT_DIR: u8 = 4;
def file_DT_BLK: u8 = 6;
def file_DT_REG: u8 = 8;
def file_DT_LNK: u8 = 10;
def file_DT_SOCK: u8 = 12;

def file_S_IFMT: u32 = 0o170000;
def file_S_IFREG: u32 = 0o100000;
def file_S_IFDIR: u32 = 0o040000;
def file_S_IFLNK: u32 = 0o120000;

type file_stat = struct {
	st_dev: u64,
	st_ino: u64,
	st_nlink: u64,
	st_mode: u32,
	st_uid: u32,
	st_gid: u32,
	__pad0: u32,
	st_rdev: u64,
	st_size: i64,
	st_blksize: i64,
	st_blocks: i64,
	st_atime: i64,
	st_atime_ns: i64,
	st_mtime: i64,
	st_mtime_ns: i64,
	st_ctime: i64,
	st_ctime_ns: i64,
	__unused0: i64,
	__unused1: i64,
	__unused2: i64,
};

@symbol("pk_open") fn file_open(path: file_cstr, flags: i32, mode: u32) i32;
@symbol("pk_close") fn file_close(fd: i32) i32;
@symbol("pk_read") fn file_read(fd: i32, buf: *opaque, count: size) i64;
@symbol("pk_write") fn file_write(fd: i32, buf: *opaque, count: size) i64;
@symbol("pk_fsync") fn file_fsync(fd: i32) i32;
@symbol("pk_ftruncate") fn file_ftruncate(fd: i32, length: i64) i32;
@symbol("pk_lseek") fn file_lseek(fd: i32, off: i64, whence: i32) i64;

def file_SEEK_SET: i32 = 0;
def file_SEEK_CUR: i32 = 1;
def file_SEEK_END: i32 = 2;

fn file_seek(fd: i32, off: i64, whence: i32) i64 = {
	return file::lseek(fd, off, whence);
};

fn file_tell(fd: i32) i64 = {
	return file::lseek(fd, 0, file::SEEK_CUR);
};

fn file_rewind(fd: i32) i64 = {
	return file::lseek(fd, 0, file::SEEK_SET);
};

@symbol("pk_fstatat") fn file_fstatat(dirfd: i32, path: file_cstr,
	buf: *file_stat, flags: i32) i32;
@symbol("pk_fstat") fn file_fstat(fd: i32, buf: *file_stat) i32;
@symbol("pk_mkdirat") fn file_mkdirat(dirfd: i32, path: file_cstr, mode: u32) i32;
@symbol("pk_unlinkat") fn file_unlinkat(dirfd: i32, path: file_cstr, flags: i32) i32;
@symbol("pk_chdir") fn file_chdir(path: file_cstr) i32;
@symbol("pk_getcwd") fn file_getcwd(buf: *[*]u8, sz: size) i32;
@symbol("pk_getdents64") fn file_getdents64(fd: i32, buf: *opaque, sz: size) i64;
@symbol("pk_readdir") fn file_readdir(fd: i32, name: *[*]u8, sz: size, kind: *u8) i32;
@symbol("pk_readdir_reset") fn file_readdir_reset() void;

def file_AT_FDCWD: i32 = -100;
def file_AT_SYMLINK_NOFOLLOW: i32 = 0x100;
def file_AT_REMOVEDIR: i32 = 0x200;

fn file_open_ro(path: file_cstr) i32 = {
	return file::open(path, file::O_RDONLY, 0);
};

fn file_open_rw(path: file_cstr) i32 = {
	return file::open(path, file::O_RDWR, 0);
};

fn file_open_rw_create(path: file_cstr, mode: u32) i32 = {
	return file::open(path, file::O_CREAT | file::O_RDWR, mode);
};

fn file_open_rw_trunc(path: file_cstr, mode: u32) i32 = {
	return file::open(path, file::O_CREAT | file::O_TRUNC | file::O_RDWR, mode);
};

fn file_write_all(fd: i32, buf: *opaque, count: size) i64 = {
	let p: *[*]u8 = buf: *[*]u8;
	let left: size = count;
	let off: size = 0;
	for (left > 0) {
		let wrote = file::write(fd, &p[off]: *opaque, left);
		if (wrote <= 0) { return wrote; };
		off += wrote: size;
		left -= wrote: size;
	};
	return count: i64;
};

fn file_read_exact(fd: i32, buf: *opaque, count: size) i64 = {
	let p: *[*]u8 = buf: *[*]u8;
	let left: size = count;
	let off: size = 0;
	for (left > 0) {
		let got = file::read(fd, &p[off]: *opaque, left);
		if (got <= 0) { return count: i64 - left: i64; };
		off += got: size;
		left -= got: size;
	};
	return count: i64;
};

fn file_stat_path(path: file_cstr, buf: *file_stat) i32 = {
	return file::fstatat(file::AT_FDCWD, path, buf, 0);
};

fn file_lstat_path(path: file_cstr, buf: *file_stat) i32 = {
	return file::fstatat(file::AT_FDCWD, path, buf, file::AT_SYMLINK_NOFOLLOW);
};

fn file_exists(path: file_cstr) bool = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	return file::stat_path(path, &st) == 0;
};

fn file_isfile(path: file_cstr) bool = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	if (file::stat_path(path, &st) != 0) { return false; };
	return (st.st_mode & file::S_IFMT) == file::S_IFREG;
};

fn file_isdir(path: file_cstr) bool = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	if (file::stat_path(path, &st) != 0) { return false; };
	return (st.st_mode & file::S_IFMT) == file::S_IFDIR;
};

fn file_islink(path: file_cstr) bool = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	if (file::lstat_path(path, &st) != 0) { return false; };
	return (st.st_mode & file::S_IFMT) == file::S_IFLNK;
};

fn file_size(path: file_cstr) i64 = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	if (file::stat_path(path, &st) != 0) { return -1; };
	return st.st_size;
};

fn file_size_fd(fd: i32) i64 = {
	let st: file_stat = file_stat {
		st_dev = 0, st_ino = 0, st_nlink = 0, st_mode = 0,
		st_uid = 0, st_gid = 0, __pad0 = 0, st_rdev = 0,
		st_size = 0, st_blksize = 0, st_blocks = 0,
		st_atime = 0, st_atime_ns = 0, st_mtime = 0, st_mtime_ns = 0,
		st_ctime = 0, st_ctime_ns = 0,
		__unused0 = 0, __unused1 = 0, __unused2 = 0,
	};
	if (file::fstat(fd, &st) != 0) { return -1; };
	return st.st_size;
};

fn file_mkdir(path: file_cstr, mode: u32) i32 = {
	return file::mkdirat(file::AT_FDCWD, path, mode);
};

fn file_rmdir(path: file_cstr) i32 = {
	return file::unlinkat(file::AT_FDCWD, path, file::AT_REMOVEDIR);
};

fn file_rm(path: file_cstr) i32 = {
	return file::unlinkat(file::AT_FDCWD, path, 0);
};

fn file_opendir(path: file_cstr) i32 = {
	file::readdir_reset();
	return file::open(path, file::O_RDONLY | file::O_DIRECTORY, 0);
};

fn file_closedir(fd: i32) i32 = {
	file::readdir_reset();
	return file::close(fd);
};
