def clock_MONOTONIC: i32 = 1;

@symbol("pk_clock_count") fn clock_count() u64;
@symbol("pk_clock_gettime") fn clock_gettime(clock_id: i32, ts: *proc_timespec) i32;

let NS_PER_COUNT: f64 = -1.0f64;

fn clock_now() u64 = {
	return clock::count();
};

fn clock_since(start_tick: u64) f64 = {
	return clock::dt(clock::now(), start_tick);
};

fn clock_dt(stop_tick: u64, start_tick: u64) f64 = {
	if (NS_PER_COUNT < 0.0f64) {
		clock::calibrate(0.05f64); // 5ms
	};
	if (stop_tick <= start_tick) { return 0.0f64; };
	let delta = stop_tick - start_tick;
	let ns = (delta: f64) * NS_PER_COUNT;
	return ns / 1000000000.0f64;
};

fn clock_calibrate(s: f64) void = {
	if (s <= 0.0f64) { return; };
	let target_ns: i64 = (s * 1000000000.0f64): i64;
	if (target_ns <= 0) { return; };
	let start_tick = clock::count();
	let start_ns = clock::monotonic_ns();
	clock::sleep_ns(target_ns);
	let stop_tick = clock::count();
	if (stop_tick <= start_tick) { return; };
	let stop_ns = clock::monotonic_ns();
	if (start_ns >= 0 && stop_ns >= 0 && stop_ns > start_ns) {
		let delta_ns: i64 = stop_ns - start_ns;
		NS_PER_COUNT = (delta_ns: f64) / ((stop_tick - start_tick): f64);
		return;
	};
	NS_PER_COUNT = (target_ns: f64) / ((stop_tick - start_tick): f64);
};

fn clock_monotonic_ns() i64 = {
	let ts = proc_timespec { sec = 0, nsec = 0 };
	if (clock::gettime(clock::MONOTONIC, &ts) != 0) { return -1; };
	return ts.sec * 1000000000 + ts.nsec;
};

fn clock_sleep_ns(ns: i64) void = {
	if (ns <= 0) { return; };
	let sec: i64 = ns / 1000000000;
	let nsec: i64 = ns % 1000000000;
	let ts = proc_timespec { sec = sec, nsec = nsec };
	proc::nanosleep(&ts, null);
};
