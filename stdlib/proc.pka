type proc_cstr = *[*]u8;
type proc_cstr_list = *[*]nullable *[*]u8;
type proc_timespec = struct {
	sec: i64,
	nsec: i64,
};

def proc_PRIO_PROCESS: i32 = 0;
def proc_PRIO_PGRP: i32 = 1;
def proc_PRIO_USER: i32 = 2;

def proc_WNOHANG: i32 = 1;

def proc_SIGHUP: i32 = 1;
def proc_SIGINT: i32 = 2;
def proc_SIGKILL: i32 = 9;
def proc_SIGTERM: i32 = 15;

def proc_PR_SET_PDEATHSIG: i32 = 1;

@symbol("pk_getppid") fn proc_getppid() i32;
@symbol("pk_kill") fn proc_kill(pid: i32, sig: i32) i32;
@symbol("pk_prctl") fn proc_prctl(
	option: i32,
	arg2: uintptr,
	arg3: uintptr,
	arg4: uintptr,
	arg5: uintptr,
) i32;

@symbol("pk_wait4") fn proc_wait4(pid: i32, status: *i32, options: i32) i32;

fn proc_wait(pid: i32, status: *i32) i32 = {
	return proc_wait4(pid, status, 0);
};

fn proc_wait_nohang(pid: i32, status: *i32) i32 = {
	return proc_wait4(pid, status, proc_WNOHANG);
};

@symbol("pk_spawn") fn proc_spawn(
	path: proc_cstr,
	argv: proc_cstr_list,
	envp: proc_cstr_list,
) i32;

fn proc_spawn_simple(path: proc_cstr) i32 = {
	let argv: [2]nullable *[*]u8 = [path: nullable *[*]u8, null];
	let env: [1]nullable *[*]u8 = [null];
	return proc_spawn(path, &argv: proc_cstr_list, &env: proc_cstr_list);
};

@symbol("pk_getpriority") fn proc_getpriority(which: i32, who: i32) i32;
@symbol("pk_setpriority") fn proc_setpriority(which: i32, who: i32, prio: i32) i32;

fn proc_setpriority_process(pid: i32, prio: i32) i32 = {
	return proc_setpriority(proc_PRIO_PROCESS, pid, prio);
};

fn proc_getpriority_process(pid: i32) i32 = {
	return proc_getpriority(proc_PRIO_PROCESS, pid);
};

@symbol("pk_exit") fn proc_exit(status: i32) void;
@symbol("pk_nanosleep") fn proc_nanosleep(
	req: *proc_timespec,
	rem: nullable *proc_timespec,
) i32;

fn proc_pdeathsig(sig: i32) i32 = {
	return proc_prctl(proc_PR_SET_PDEATHSIG, sig: uintptr, 0, 0, 0);
};

fn proc_sleep_ms(ms: i32) void = {
    // Convert the millisecond value to a double-precision float once.
    let f_ms = ms: f64;
    // Total seconds as a float.
    let f_sec = f_ms * (1.0f64 / 1000.0f64);
    // Extract integer part (seconds) and fractional part.
    let sec = (f_sec: i64);
    let frac = f_sec - (sec: f64);
    // Fractional seconds to nanoseconds.
    let nsec: i64 = (frac * 1_000_000_000.0f64): i64;
    let ts = proc_timespec { sec = sec, nsec = nsec };
    proc_nanosleep(&ts, null);
};

// Non-blocking check if a child process has terminated.
//
// Returns:
// * `null` if the child is still running.
// * `>=0` normal exit code (non-negative).
// * `<0` negative signal number that killed the child.
type alive = !void;
type procstatus = (alive | i32);
fn proc_check(pid: i32) procstatus = {
    let status: i32 = 0;
    let ret = proc_wait_nohang(pid, &status);
    if (ret > 0) {
        // Process has exited - decode WIFEXITED / WIFSIGNALED
        // Bits 0-6: exit status or signal number
        // Bit 7: exited normally (0) or signaled (1)
        if ((status & 0x80) == 0) {
            // Normal exit: bits 8-15 contain exit code
            return (status >> 8): procstatus;
        } else {
            // Terminated by signal: bits 0-6 contain signum
            return -(status & 0x7F): procstatus;
        };
    };
    return alive:procstatus;
};
