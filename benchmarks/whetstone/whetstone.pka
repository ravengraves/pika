// whetstone.pka - Whetstone Benchmark for Pika
// Adapted from Roy Longbottom's C/C++ Whetstone Benchmark
// Single precision version using Pika's math stdlib

use rt;
use strings;

// Section results (stored during benchmark, printed at end)
let whet_sec_result: [9]f64 = [0...];
let whet_sec_mflops: [9]f64 = [0...];
let whet_sec_mops: [9]f64 = [0...];
let whet_sec_time: [9]f64 = [0...];
let whet_check: f64 = 0.0f64;

// Anti-DCE
let whet_opaque: i64 = 0;
let whet_n3_seeds: [256]i64 = [0...];

fn whet_init_n3_seeds() void = {
    for (let si: i32 = 0; si < 256; si += 1) {
        whet_n3_seeds[si: size] = (si & 1): i64;
    };
    benchmark_compiler_barrier();
};

// --- Helper procedures (from original Whetstone) ---

fn whet_pa(e: *[*]f32, t: f32, t2: f32) void = {
    for (let j: i32 = 0; j < 6; j += 1) {
        e[0] = (e[0] + e[1] + e[2] - e[3]) * t;
        e[1] = (e[0] + e[1] - e[2] + e[3]) * t;
        e[2] = (e[0] - e[1] + e[2] + e[3]) * t;
        e[3] = (-e[0] + e[1] + e[2] + e[3]) / t2;
    };
};

fn whet_po(e: *[*]f32, j: i32, k: i32, l: i32) void = {
    e[j: size] = e[k: size];
    e[k: size] = e[l: size];
    e[l: size] = e[j: size];
};

fn whet_p3(px: *f32, py: *f32, pz: *f32, t: f32, t1: f32, t2: f32) void = {
    *px = *py;
    *py = *pz;
    *px = t * (*px + *py);
    *py = t1 * (*px + *py);
    *pz = (*px + *py) / t2;
};

// Print a section line in C's format
fn whet_print_line(title: str, section: i32, is_mflops: bool) void = {
    bench_write(title);
    bench_write(" ");
    bench_write_f64_right(whet_sec_result[section: size], 17, 24);
    bench_write("    ");
    if (is_mflops) {
        bench_write(" ");
        bench_write_f64_right(whet_sec_mflops[section: size], 3, 9);
        bench_write_spaces(10);
        bench_write_f64_right(whet_sec_time[section: size], 3, 9);
    } else {
        bench_write_spaces(11);
        bench_write_f64_right(whet_sec_mops[section: size], 3, 9);
        bench_write_f64_right(whet_sec_time[section: size], 3, 9);
    };
    bench_nl();
};

export fn main() void = {
    let x100: i64 = 100000;
    let xtra: i64 = 1;

    let t: f32 = 0.49999975f32;
    let t0: f32 = t;
    let t1: f32 = 0.50000025f32;
    let t2: f32 = 2.0f32;

    let n1: i64 = 12 * x100;
    let n2: i64 = 14 * x100;
    let n3: i64 = 345 * x100;
    let n4: i64 = 210 * x100;
    let n5: i64 = 32 * x100;
    let n6: i64 = 899 * x100;
    let n7: i64 = 616 * x100;
    let n8: i64 = 93 * x100;

    let e1: [4]f32 = [0...];
    let total_time: f64 = 0.0f64;

    // --- Section 1: Array elements ---
    e1[0] = 1.0; e1[1] = -1.0; e1[2] = -1.0; e1[3] = -1.0;
    let ts1 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n1 * 10; i += 1) {
            e1[0] = (e1[0] + e1[1] + e1[2] - e1[3]) * t;
            e1[1] = (e1[0] + e1[1] - e1[2] + e1[3]) * t;
            e1[2] = (e1[0] - e1[1] + e1[2] + e1[3]) * t;
            e1[3] = (-e1[0] + e1[1] + e1[2] + e1[3]) * t;
        };
        t = 1.0f32 - t;
    };
    t = t0;
    let te1 = bench_time_ns();
    let sec1 = bench_elapsed_s(ts1, te1) / 10.0f64;
    total_time += sec1;
    whet_sec_result[1] = (e1[3]: f64);
    whet_sec_mflops[1] = ((n1 * 16): f64) * (xtra: f64) / (1000000.0f64 * sec1);
    whet_sec_time[1] = sec1;

    // --- Section 2: Array as parameter ---
    let ts2 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n2; i += 1) {
            whet_pa(&e1: *[*]f32, t, t2);
        };
        t = 1.0f32 - t;
    };
    t = t0;
    let te2 = bench_time_ns();
    let sec2 = bench_elapsed_s(ts2, te2);
    total_time += sec2;
    whet_sec_result[2] = (e1[3]: f64);
    whet_sec_mflops[2] = ((n2 * 96): f64) * (xtra: f64) / (1000000.0f64 * sec2);
    whet_sec_time[2] = sec2;

    // --- Section 3: Conditional jumps ---
    whet_init_n3_seeds();
    let j: i64 = 1;
    let ts3 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n3; i += 1) {
            if (j == 1) { j = 2; } else if (j == 0) { j = 3; } else { break; };
            if (j > 2)  { j = 0; } else { j = 1; };
            if (j < 1)  { j = 1; } else { j = 0; };
            whet_n3_seeds[(i & 255): size] = j;
            benchmark_compiler_barrier();
            j = whet_n3_seeds[((i + 1) & 255): size];
        };
    };
    let te3 = bench_time_ns();
    let sec3 = bench_elapsed_s(ts3, te3);
    total_time += sec3;
    whet_sec_result[3] = (j: f64);
    whet_sec_mops[3] = ((n3 * 3): f64) * (xtra: f64) / (1000000.0f64 * sec3);
    whet_sec_time[3] = sec3;

    // --- Section 4: Integer arithmetic ---
    j = 1;
    let k: i64 = 2;
    let l: i64 = 3;
    let ts4 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n4; i += 1) {
            j = j * (k - j) * (l - k);
            k = l * k - (l - j) * k;
            l = (l - k) * (k + j);
            e1[(l - 2): size] = (j + k + l): f32;
            e1[(k - 2): size] = (j * k * l): f32;
            whet_opaque = j;
            benchmark_compiler_barrier();
            j = whet_opaque;
        };
    };
    let te4 = bench_time_ns();
    let sec4 = bench_elapsed_s(ts4, te4);
    total_time += sec4;
    let x4: f64 = (e1[0]: f64) + (e1[1]: f64);
    whet_sec_result[4] = x4;
    whet_sec_mops[4] = ((n4 * 15): f64) * (xtra: f64) / (1000000.0f64 * sec4);
    whet_sec_time[4] = sec4;

    // --- Section 5: Trig functions ---
    let x: f32 = 0.5;
    let y: f32 = 0.5;
    let ts5 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 1; i < n5; i += 1) {
            x = t * math_atan(t2 * math_sin(x) * math_cos(x) /
                (math_cos(x + y) + math_cos(x - y) - 1.0f32));
            y = t * math_atan(t2 * math_sin(y) * math_cos(y) /
                (math_cos(x + y) + math_cos(x - y) - 1.0f32));
        };
        t = 1.0f32 - t;
    };
    t = t0;
    let te5 = bench_time_ns();
    let sec5 = bench_elapsed_s(ts5, te5);
    total_time += sec5;
    whet_sec_result[5] = (y: f64);
    whet_sec_mops[5] = ((n5 * 26): f64) * (xtra: f64) / (1000000.0f64 * sec5);
    whet_sec_time[5] = sec5;

    // --- Section 6: Procedure calls ---
    x = 1.0;
    y = 1.0;
    let z: f32 = 1.0;
    let ts6 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n6; i += 1) {
            whet_p3(&x, &y, &z, t, t1, t2);
        };
    };
    let te6 = bench_time_ns();
    let sec6 = bench_elapsed_s(ts6, te6);
    total_time += sec6;
    whet_sec_result[6] = (z: f64);
    whet_sec_mflops[6] = ((n6 * 6): f64) * (xtra: f64) / (1000000.0f64 * sec6);
    whet_sec_time[6] = sec6;

    // --- Section 7: Array references ---
    j = 0; k = 1; l = 2;
    e1[0] = 1.0; e1[1] = 2.0; e1[2] = 3.0;
    let ts7 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n7; i += 1) {
            whet_po(&e1: *[*]f32, j: i32, k: i32, l: i32);
            benchmark_compiler_barrier();
        };
    };
    let te7 = bench_time_ns();
    let sec7 = bench_elapsed_s(ts7, te7);
    total_time += sec7;
    whet_sec_result[7] = (e1[2]: f64);
    whet_sec_mops[7] = ((n7 * 3): f64) * (xtra: f64) / (1000000.0f64 * sec7);
    whet_sec_time[7] = sec7;

    // --- Section 8: Standard functions ---
    x = 0.75;
    let ts8 = bench_time_ns();
    for (let ix: i64 = 0; ix < xtra; ix += 1) {
        for (let i: i64 = 0; i < n8; i += 1) {
            x = math_sqrt(math_exp(math_log(x) / t1));
        };
    };
    let te8 = bench_time_ns();
    let sec8 = bench_elapsed_s(ts8, te8);
    total_time += sec8;
    whet_sec_result[8] = (x: f64);
    whet_sec_mops[8] = ((n8 * 4): f64) * (xtra: f64) / (1000000.0f64 * sec8);
    whet_sec_time[8] = sec8;

    // --- Accumulate check ---
    for (let s: i32 = 1; s <= 8; s += 1) {
        whet_check += whet_sec_result[s: size];
    };

    // --- Print results (C format) ---
    bench_write("\n Single Precision Pika Whetstone Benchmark\n");
    bench_write("         GCC Linux\n");
    bench_write("         -O3 -ffast-math\n");
    bench_write("\nLoop content                  Result              MFLOPS      MOPS   Seconds\n\n");

    whet_print_line("N1 floating point", 1, true);
    whet_print_line("N2 floating point", 2, true);
    whet_print_line("N3 if then else  ", 3, false);
    whet_print_line("N4 fixed point   ", 4, false);
    whet_print_line("N5 sin,cos etc.  ", 5, false);
    whet_print_line("N6 floating point", 6, true);
    whet_print_line("N7 assignments   ", 7, false);
    whet_print_line("N8 exp,sqrt etc. ", 8, false);

    bench_nl();
    let mwips = (xtra: f64) * (x100: f64) / (10.0f64 * total_time);
    bench_write("MWIPS            ");
    bench_write_f64_right(mwips, 3, 39);
    bench_write_f64_right(total_time, 3, 19);
    bench_nl();
    bench_nl();

    if (whet_check == 0.0f64) {
        bench_write("Wrong answer\n");
    };
};
