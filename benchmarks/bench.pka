// bench.pka - Shared utilities for Pika benchmarks
// Provides text output and timing helpers using the standard library.

use rt;
use strings;
use clock;
use fb;

// Write a string to stdout
fn bench_write(s: str) void = {
    fb::Prints(s);
};

// Write a newline to stdout
fn bench_nl() void = {
    fb::Prints("\n");
};

// Write an unsigned 64-bit integer to stdout
fn bench_write_u64(val: u64) void = {
    let storage: [24]u8 = [0...];
    let b = fb::New(storage[0z..24z]);
    fb::Wu64(&b, val);
    fb::Print(&b);
};

// Write a signed 64-bit integer to stdout
fn bench_write_i64(n: i64) void = {
    let storage: [24]u8 = [0...];
    let b = fb::New(storage[0z..24z]);
    fb::Wi64(&b, n);
    fb::Print(&b);
};

// Write a signed 32-bit integer to stdout
fn bench_write_i32(n: i32) void = {
    bench_write_i64(n: i64);
};

// Write val as decimal, zero-padded to width digits
fn bench_write_padded(val: u64, width: i32) void = {
    let storage: [24]u8 = [0...];
    let b = fb::New(storage[0z..24z]);
    fb::Wu64(&b, val, "dec", width);
    fb::Print(&b);
};

// Write an f64 with given decimal places
fn bench_write_f64(v: f64, decimals: i32) void = {
    let storage: [64]u8 = [0...];
    let b = fb::New(storage[0z..64z]);
    fb::Wf64(&b, v, decimals, "dec");
    fb::Print(&b);
};

// Write n space characters
fn bench_write_spaces(n: i32) void = {
    let storage: [64]u8 = [0...];
    let b = fb::New(storage[0z..64z]);
    let count: i32 = n;
    if (count > 64) { count = 64; };
    for (let i: i32 = 0; i < count; i += 1) {
        fb::Write(&b, " ");
    };
    fb::Print(&b);
};

// Write an f64 right-aligned in a field of given width
fn bench_write_f64_right(v: f64, decimals: i32, width: i32) void = {
    let storage: [64]u8 = [0...];
    let b = fb::New(storage[0z..64z]);
    fb::Wf64(&b, v, decimals, "dec");
    let slen: i32 = b.index: i32;
    let pad: i32 = width - slen;
    if (pad > 0) {
        bench_write_spaces(pad);
    };
    fb::Print(&b);
};

// Get monotonic time in nanoseconds
fn bench_time_ns() i64 = {
    return clock::TimeNS();
};

// Calculate elapsed seconds between two nanosecond timestamps
fn bench_elapsed_s(start_ns: i64, end_ns: i64) f64 = {
    let delta: i64 = end_ns - start_ns;
    return (delta: f64) / 1000000000.0f64;
};
