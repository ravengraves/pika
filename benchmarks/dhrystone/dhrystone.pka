// dhrystone.pka - Dhrystone Benchmark for Pika
// Adapted from Reinhold P. Weicker's Dhrystone 1.1
// Adapted: malloc -> static allocation, strings -> byte arrays

use rt;
use strings;

// --- Enumerations ---
def DHRY_IDENT1: i32 = 0;
def DHRY_IDENT2: i32 = 1;
def DHRY_IDENT3: i32 = 2;
def DHRY_IDENT4: i32 = 3;
def DHRY_IDENT5: i32 = 4;

// --- Record type (sans string field, stored separately) ---
type dhry_record = struct {
	ptr_comp: i32,
	discr: i32,
	enum_comp: i32,
	int_comp: i32,
};

// --- Global state ---
let dhry_opaque: i32 = 0; // anti-DCE: route locals through global to make them opaque
let dhry_IntGlob: i32 = 0;
let dhry_BoolGlob: bool = false;
let dhry_Char1Glob: u8 = 0;
let dhry_Char2Glob: u8 = 0;
let dhry_Array1Glob: [51]i32 = [0...];
let dhry_Array2Glob: [2601]i32 = [0...];

// Two static records (replacing malloc)
let dhry_RecNext: dhry_record = dhry_record { ptr_comp = -1, discr = 0, enum_comp = 0, int_comp = 0 };
let dhry_RecGlb: dhry_record = dhry_record { ptr_comp = 0, discr = 0, enum_comp = 0, int_comp = 0 };

// String storage for records and locals (31 bytes each, null-terminated)
let dhry_StrGlb: [31]u8 = [0...];
let dhry_StrNext: [31]u8 = [0...];
let dhry_Str1Loc: [31]u8 = [0...];
let dhry_Str2Loc: [31]u8 = [0...];

// --- String helpers (byte array operations) ---

fn dhry_str_set(dst: *[*]u8, src: str) void = {
	let bytes = strings::toutf8(src);
	let n = len(bytes);
	for (let i = 0z; i < n; i += 1) {
		dst[i] = bytes[i];
	};
	dst[n] = 0;
};

fn dhry_str_cpy(dst: *[*]u8, src: *[*]u8) void = {
	rt::memcpy(dst: *opaque, src: *opaque, 31z);
};

fn dhry_str_cmp(a: *[*]u8, b: *[*]u8) bool = {
	let sa = strings::fromutf8_unsafe(a[0..31]);
	let sb = strings::fromutf8_unsafe(b[0..31]);
	return sa == sb;
};

// --- Record helpers ---

fn dhry_rec_copy(dst: *dhry_record, src: *dhry_record) void = {
	dst.ptr_comp = src.ptr_comp;
	dst.discr = src.discr;
	dst.enum_comp = src.enum_comp;
	dst.int_comp = src.int_comp;
};

// --- Procedures (adapted from Dhrystone 1.1) ---

fn dhry_Func3(ep: i32) bool = {
	if (ep == DHRY_IDENT3) { return true; };
	return false;
};

fn dhry_Func1(ch1: u8, ch2: u8) i32 = {
	if (ch1 != ch2) {
		return DHRY_IDENT1;
	} else {
		return DHRY_IDENT2;
	};
};

fn dhry_Func2(s1: *[*]u8, s2: *[*]u8) bool = {
	let intloc: i32 = 1;
	let charloc: u8 = 0;
	for (intloc <= 1) {
		if (dhry_Func1(s1[intloc: size], s2[(intloc + 1): size]) == DHRY_IDENT1) {
			charloc = 'A';
			intloc += 1;
		};
	};
	if (charloc >= 'W' && charloc <= 'Z') {
		intloc = 7;
	};
	if (charloc == 'X') {
		return true;
	};
	if (dhry_str_cmp(s1, s2)) {
		intloc += 7;
		return true;
	} else {
		return false;
	};
};

fn dhry_Proc7(i1: i32, i2: i32, out: *i32) void = {
	let loc = i1 + 2;
	*out = i2 + loc;
};

fn dhry_Proc6(ein: i32, eout: *i32) void = {
	*eout = ein;
	if (!dhry_Func3(ein)) {
		*eout = DHRY_IDENT4;
	};
	switch (ein) {
	case 0 => *eout = DHRY_IDENT1; // Ident1
	case 1 => { // Ident2
		if (dhry_IntGlob > 100) { *eout = DHRY_IDENT1; }
		else { *eout = DHRY_IDENT4; };
	};
	case 2 => *eout = DHRY_IDENT2; // Ident3
	case 3 => void; // Ident4: no action
	case 4 => *eout = DHRY_IDENT3; // Ident5
	case => void;
	};
};

fn dhry_Proc8(a1: *[*]i32, a2: *[*]i32, i1: i32, i2: i32) void = {
	let loc = i1 + 5;
	a1[loc: size] = i2;
	a1[(loc + 1): size] = a1[loc: size];
	a1[(loc + 30): size] = loc;
	for (let idx: i32 = loc; idx <= loc + 1; idx += 1) {
		a2[(loc * 51 + idx): size] = loc;
	};
	a2[(loc * 51 + loc - 1): size] += 1;
	a2[((loc + 20) * 51 + loc): size] = a1[loc: size];
	dhry_IntGlob = 5;
};

fn dhry_Proc5() void = {
	dhry_Char1Glob = 'A';
	dhry_BoolGlob = false;
};

fn dhry_Proc4() void = {
	let bloc: bool = dhry_Char1Glob == 'A';
	if (bloc || dhry_BoolGlob) {
		dhry_Char2Glob = 'B';
	};
};

fn dhry_Proc3(out: *i32) void = {
	if (dhry_RecGlb.ptr_comp >= 0) {
		*out = dhry_RecGlb.enum_comp;
	} else {
		dhry_IntGlob = 100;
	};
	dhry_Proc7(10, dhry_IntGlob, &dhry_RecGlb.int_comp);
};

fn dhry_Proc2(io: *i32) void = {
	let intloc = *io + 10;
	let eloc: i32 = 0;
	for (true) {
		if (dhry_Char1Glob == 'A') {
			intloc -= 1;
			*io = intloc - dhry_IntGlob;
			eloc = DHRY_IDENT1;
		};
		if (eloc == DHRY_IDENT1) { break; };
	};
};

fn dhry_Proc1() void = {
	// NextRecord = *PtrGlb (struct copy)
	dhry_rec_copy(&dhry_RecNext, &dhry_RecGlb);
	dhry_str_cpy(&dhry_StrNext: *[*]u8, &dhry_StrGlb: *[*]u8);
	benchmark_compiler_barrier(); // matches C's strcpy barrier in Proc1
	dhry_RecGlb.int_comp = 5;
	dhry_RecNext.int_comp = dhry_RecGlb.int_comp;
	dhry_RecNext.ptr_comp = dhry_RecGlb.ptr_comp;
	dhry_Proc3(&dhry_RecNext.enum_comp);
	if (dhry_RecNext.discr == DHRY_IDENT1) {
		dhry_RecNext.int_comp = 6;
		dhry_Proc6(dhry_RecGlb.enum_comp, &dhry_RecNext.enum_comp);
		dhry_RecNext.ptr_comp = dhry_RecGlb.ptr_comp;
		dhry_Proc7(dhry_RecNext.int_comp, 10, &dhry_RecNext.int_comp);
	} else {
		dhry_rec_copy(&dhry_RecGlb, &dhry_RecNext);
	};
};

// --- Main benchmark loop ---

export fn main() void = {
	// Initialize records
	dhry_RecGlb.ptr_comp = 0; // points to RecNext (index 0)
	dhry_RecGlb.discr = DHRY_IDENT1;
	dhry_RecGlb.enum_comp = DHRY_IDENT3;
	dhry_RecGlb.int_comp = 40;
	dhry_str_set(&dhry_StrGlb: *[*]u8, "DHRYSTONE PROGRAM, SOME STRING");
	dhry_str_set(&dhry_Str1Loc: *[*]u8, "DHRYSTONE PROGRAM, 1'ST STRING");

	let loops: u64 = 100_000_000;

	dhry_Array2Glob[8 * 51 + 7] = 10;

	let start_ns = bench_time_ns();

	for (let i: u64 = 0; i < loops; i += 1) {
		dhry_Proc5();
		dhry_Proc4();
		let intloc1: i32 = 2;
		let intloc2: i32 = 3;
		let intloc3: i32 = 0;
		dhry_str_set(&dhry_Str2Loc: *[*]u8, "DHRYSTONE PROGRAM, 2'ND STRING");
		benchmark_compiler_barrier();
		let enumloc: i32 = DHRY_IDENT2;
		dhry_BoolGlob = !dhry_Func2(&dhry_Str1Loc: *[*]u8, &dhry_Str2Loc: *[*]u8);
		benchmark_compiler_barrier();
		for (intloc1 < intloc2) {
			intloc3 = 5 * intloc1 - intloc2;
			dhry_Proc7(intloc1, intloc2, &intloc3);
			intloc1 += 1;
		};
		dhry_Proc8(&dhry_Array1Glob: *[*]i32, &dhry_Array2Glob: *[*]i32, intloc1, intloc3);
		dhry_Proc1();
		for (let ch: u8 = 'A'; ch <= dhry_Char2Glob; ch += 1) {
			// Route ch and enumloc through global+barrier to make them opaque.
			// Without this, the compiler proves Func1(ch,'C') is constant and
			// eliminates the entire loop body including the Proc6 call.
			dhry_opaque = ch: i32;
			benchmark_compiler_barrier();
			if (enumloc == dhry_Func1(dhry_opaque: u8, 'C')) {
				dhry_Proc6(DHRY_IDENT1, &enumloc);
			};
			dhry_opaque = enumloc;
			benchmark_compiler_barrier();
			enumloc = dhry_opaque;
		};
		intloc3 = intloc2 * intloc1;
		intloc2 = intloc3 / intloc1;
		intloc2 = 7 * (intloc3 - intloc2) - intloc1;
		dhry_Proc2(&intloc1);
		// Sink all local results through global to prevent DCE.
		// enumloc must be included so the character loop body is preserved.
		dhry_opaque = enumloc + intloc1 + intloc2;
		benchmark_compiler_barrier();
	};

	let end_ns = bench_time_ns();
	let elapsed = bench_elapsed_s(start_ns, end_ns);

	bench_nl();
	bench_write("Dhrystone Benchmark, Version 1.1 (Language: Pika)\n");
	bench_nl();

	bench_write_f64_right((loops: f64), 0, 12);
	bench_write(" runs ");
	bench_write_f64(elapsed, 2);
	bench_write(" seconds \n");
	bench_nl();

	bench_write("Array2Glob8/7: ");
	if (dhry_Array2Glob[8 * 51 + 7] == (loops: i32) + 10) {
		bench_write("O.K.  ");
	} else {
		bench_write("WRONG ");
	};
	bench_write_f64_right((dhry_Array2Glob[8 * 51 + 7]: f64), 0, 12);
	bench_nl();

	let usec = elapsed * 1000000.0f64 / (loops: f64);
	let dps = (loops: f64) / elapsed;
	let vax_mips = dps / 1757.0f64;

	bench_nl();
	bench_write("Microseconds for one run through Dhrystone: ");
	bench_write_f64_right(usec, 2, 12);
	bench_write(" \n");
	bench_write("Dhrystones per Second:                      ");
	bench_write_f64_right(dps, 0, 10);
	bench_write(" \n");
	bench_write("VAX  MIPS rating =                          ");
	bench_write_f64_right(vax_mips, 2, 12);
	bench_write(" \n");
	bench_nl();

	// Anti-DCE: print all global state to prevent dead store elimination
	bench_write("Global values (anti-DCE check):\n");
	bench_write("  IntGlob:      "); bench_write_i32(dhry_IntGlob); bench_nl();
	bench_write("  BoolGlob:     "); bench_write_i32(dhry_BoolGlob: i32); bench_nl();
	bench_write("  Char1Glob:    "); bench_write_i32(dhry_Char1Glob: i32); bench_nl();
	bench_write("  Char2Glob:    "); bench_write_i32(dhry_Char2Glob: i32); bench_nl();
	bench_write("  Array1Glob[8]:"); bench_write_i32(dhry_Array1Glob[8]); bench_nl();
	bench_write("  RecGlb.int_comp:  "); bench_write_i32(dhry_RecGlb.int_comp); bench_nl();
	bench_write("  RecGlb.enum_comp: "); bench_write_i32(dhry_RecGlb.enum_comp); bench_nl();
	bench_write("  RecNext.discr:    "); bench_write_i32(dhry_RecNext.discr); bench_nl();
	bench_write("  RecNext.enum_comp:"); bench_write_i32(dhry_RecNext.enum_comp); bench_nl();
	bench_write("  RecNext.int_comp: "); bench_write_i32(dhry_RecNext.int_comp); bench_nl();
	bench_write("  RecNext.ptr_comp: "); bench_write_i32(dhry_RecNext.ptr_comp); bench_nl();
	let str_chk: i32 = 0;
	for (let i = 0z; i < 31; i += 1) {
		str_chk += (dhry_StrGlb[i]: i32) + (dhry_StrNext[i]: i32);
	};
	bench_write("  StrChecksum:      "); bench_write_i32(str_chk); bench_nl();
};
